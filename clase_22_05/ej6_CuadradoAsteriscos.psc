Algoritmo CuadradoAsteriscos
	Definir lado, f, c Como Entero
	
	Escribir "Lado del cuadrado:"
	Leer lado
	
	Para f <- 1 Hasta lado Con Paso 1 Hacer
		Para c <- 1 Hasta lado Con Paso 1 Hacer
			Escribir Sin Saltar "* "
		FinPara
		Escribir "" // Hace el salto de línea al terminar la fila
	FinPara
FinAlgoritmo
